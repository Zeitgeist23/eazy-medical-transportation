<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="description" content="Find independent transportation providers for recurring dialysis appointments by ZIP code, mobility needs, and service type."><meta name="robots" content="index,follow"><link rel="canonical" href="https://www.ride2dialysis.com/"><title>Ride2Dialysis.com | Dialysis Transportation Directory</title><style> :root{ --teal:#078896;--teal-dark:#006d7a;--navy:#0a3046;--ink:#15394d;--muted:#607785; --ice:#f1fafb;--line:#d7e6eb;--white:#fff;--orange:#f49a21; --shadow:0 18px 44px rgba(25,70,91,.14);--pad:clamp(22px,4.3vw,74px); } *{box-sizing:border-box} html{scroll-behavior:smooth} html,body{margin:0;width:100%;min-height:100%;overflow-x:hidden;background:#fff} body{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;color:var(--ink);line-height:1.45;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility} button,input,select{font:inherit}button,a{touch-action:manipulation}a{color:inherit}.container{width:100%;padding-inline:var(--pad)} .icon{display:block;width:1.35em;height:1.35em;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round} .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0} .site-header{height:92px;background:#fff;border-bottom:1px solid #edf3f5;display:flex;align-items:center;position:sticky;top:0;z-index:100} .nav{display:flex;align-items:center;justify-content:space-between;gap:28px} .brand{display:flex;align-items:center;gap:13px;text-decoration:none;color:var(--teal-dark);font-weight:850;font-size:clamp(25px,2vw,34px);letter-spacing:-.045em;white-space:nowrap} .brand-mark{width:60px;height:60px;flex:0 0 60px} .desktop-nav{display:flex;align-items:center;gap:clamp(11px,1.65vw,29px)} .desktop-nav a{text-decoration:none;font-weight:740;font-size:15px;padding:13px 4px;white-space:nowrap} .desktop-nav a.active{color:var(--teal-dark);border-bottom:3px solid var(--teal)} .find-top{display:flex;align-items:center;gap:9px;background:linear-gradient(180deg,#0b94a2,#087d8c);color:#fff!important;border-radius:10px;padding:14px 20px!important;box-shadow:0 7px 18px rgba(4,128,144,.2)} .find-top .icon{width:20px;height:20px} .menu-button{display:none;align-items:center;justify-content:center;width:46px;height:44px;border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--navy);font-size:23px;cursor:pointer} .mobile-panel{display:none} .hero{position:relative;min-height:646px;overflow:hidden;background:linear-gradient(94deg,#fff 0%,#fff 43%,#f1fafb 60%,#e7f6f8 100%)} .hero-photo{position:absolute;inset:0 0 0 auto;width:53%;height:100%;z-index:0} .hero-photo img{width:100%;height:100%;object-fit:cover;object-position:center center;display:block} .hero::after{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(90deg,#fff 0%,#fff 41%,rgba(255,255,255,.94) 46%,rgba(255,255,255,.52) 53%,rgba(255,255,255,0) 64%)} .hero-content{position:relative;z-index:2;padding-top:62px;padding-bottom:54px} .hero-copy{width:min(850px,54vw)} .hero h1{margin:0;color:var(--navy);font-size:clamp(56px,4.15vw,72px);line-height:.99;letter-spacing:-.052em;font-weight:860} .hero h1 .line{display:block}.hero h1 .line:first-child{white-space:nowrap}.hero h1 em{color:var(--teal);font-style:normal} .hero-copy>p{font-size:clamp(18px,1.3vw,22px);line-height:1.58;max-width:730px;margin:22px 0 0;color:#294e61} .finder{margin-top:34px;width:min(1040px,72vw);background:#fff;border:1px solid #dce9ed;border-radius:16px;box-shadow:var(--shadow);padding:22px 24px;position:relative;z-index:4} .finder-grid{display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:15px;align-items:end} .field{display:grid;gap:8px}.field label{font-size:14px;font-weight:820;color:#15384c} .control{height:57px;border:1px solid #cadce4;border-radius:10px;background:#fff;display:flex;align-items:center;gap:11px;padding:0 15px;color:#577180;box-shadow:inset 0 0 0 1px rgba(8,136,150,.01)} .control:focus-within{border-color:var(--teal);box-shadow:0 0 0 3px rgba(7,136,150,.12)} .control .icon{color:var(--teal);width:22px;height:22px;flex:0 0 22px} .control input,.control select{border:0;outline:0;background:transparent;width:100%;min-width:0;color:#526c7a;font-size:15px} .control input::placeholder{color:#667d8a;opacity:1}.control select{appearance:auto} .search-btn{height:57px;border:0;border-radius:10px;background:linear-gradient(180deg,#0b95a3,#087c8c);color:#fff;font-weight:820;padding:0 25px;cursor:pointer;display:flex;align-items:center;gap:9px;box-shadow:0 7px 15px rgba(4,128,144,.18)} .search-btn:hover,.find-top:hover{filter:brightness(.98)}.search-btn .icon{width:21px;height:21px} .finder-points{border-top:1px solid #dce8ec;margin-top:19px;padding-top:17px;display:grid;grid-template-columns:repeat(3,1fr);gap:18px} .point{display:grid;grid-template-columns:38px 1fr;gap:11px;align-items:center} .point-icon{width:36px;height:36px;border:2px solid var(--teal);border-radius:50%;display:grid;place-items:center;color:var(--teal)} .point-icon .icon{width:19px;height:19px}.point b{display:block;font-size:14px;color:#15384c}.point span{display:block;font-size:12px;color:#687e8b;margin-top:2px} .directory-note{background:#eef9fb;border-top:1px solid #e0eff2;border-bottom:1px solid #e0eff2} .directory-note .container{min-height:78px;display:flex;align-items:center;justify-content:center;gap:16px} .shield-icon{width:44px;height:48px;flex:0 0 44px;color:var(--teal)}.shield-icon .icon{width:100%;height:100%} .directory-note p{margin:0;font-size:14px;color:#31596c}.directory-note strong{color:#0b7685} .section{padding:52px 0}.section h2,.providers-section h2,.benefits-section h2{margin:0;color:var(--navy);font-size:clamp(30px,3vw,43px);line-height:1.05;letter-spacing:-.035em;text-align:center} .steps{display:grid;grid-template-columns:repeat(3,1fr);margin-top:34px} .step{display:grid;grid-template-columns:88px 1fr;gap:21px;align-items:start;padding:14px 35px;position:relative} .step:not(:last-child){border-right:1px dashed #8dbfc8}.step-icon{width:84px;height:84px;border-radius:22px;background:#e9f6f8;display:grid;place-items:center;color:var(--teal)} .step-icon .icon{width:48px;height:48px;stroke-width:1.7}.step-title{display:flex;align-items:center;gap:10px;font-weight:850;font-size:18px;color:#14374b} .num{width:29px;height:29px;border-radius:50%;background:var(--teal);color:#fff;display:grid;place-items:center;font-size:14px;flex:0 0 29px}.step p{margin:8px 0 0;color:#5c7180;font-size:14px;line-height:1.65} .providers-section{background:linear-gradient(180deg,#f8fcfd,#fff);padding:30px 0 48px}.providers-head{display:flex;justify-content:space-between;align-items:center;gap:22px;margin-bottom:21px}.providers-head h2{text-align:left;font-size:clamp(27px,2.25vw,36px)} .view-all{color:var(--teal-dark);font-weight:820;text-decoration:none;white-space:nowrap}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:19px} .card{background:#fff;border:1px solid #dbe7eb;border-radius:14px;overflow:hidden;box-shadow:0 8px 22px rgba(26,73,92,.07)} .vehicle-frame{width:100%;height:178px;padding:9px;background:#eef6f8;display:flex;align-items:center;justify-content:center;overflow:hidden} .vehicle-photo{display:block;width:100%;height:100%;object-fit:contain;object-position:center} .card-body{padding:14px}.card h3{font-size:17px;margin:0;color:#16384b;line-height:1.28}.rating{margin-top:6px;font-size:13px;color:#586e7c}.stars{color:var(--orange);letter-spacing:1px}.place{margin-top:7px;font-size:13px;color:#617987}.tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}.tag{border-radius:999px;background:#e9f6f7;color:#087786;font-size:11px;padding:5px 9px}.profile{margin-top:12px;width:100%;height:40px;background:#fff;border:1px solid #0d91a0;border-radius:7px;color:#087786;font-weight:820;cursor:pointer} .benefits-section{background:#f5fbfc;padding:39px 0}.benefits-section h2{font-size:clamp(27px,2.4vw,36px)}.benefits{display:grid;grid-template-columns:repeat(5,1fr);margin-top:31px}.benefit{text-align:center;padding:5px 24px}.benefit:not(:last-child){border-right:1px dashed #8fc4ce} .benefit-icon{width:62px;height:62px;margin:0 auto 12px;border-radius:50%;background:#e3f3f5;display:grid;place-items:center;color:var(--teal)}.benefit-icon .icon{width:32px;height:32px}.benefit b{font-size:14px;color:#17394d}.benefit p{font-size:12px;color:#647986;margin:6px 0 0;line-height:1.55} .popular{padding:25px 0 20px}.popular h2{margin:0;text-align:center;font-size:25px;color:#087f8e}.cities-row{display:grid;grid-template-columns:repeat(6,1fr);gap:18px;margin-top:19px}.city{min-height:45px;border:1px solid #d6e5e9;border-radius:8px;background:#fff;color:#087786;font-weight:820;font-size:13px;display:flex;align-items:center;justify-content:center;gap:8px;text-decoration:none;padding:8px}.c