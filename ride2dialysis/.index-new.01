ity .icon{width:17px;height:17px}.popular-note{text-align:center;color:#667b88;font-size:13px;margin-top:10px} .footer{background:linear-gradient(105deg,#067181,#05899a);color:#fff}.footer-grid{display:grid;grid-template-columns:1.35fr .8fr .9fr 1.05fr 1.35fr;gap:34px;padding-top:31px;padding-bottom:25px}.footer-brand{font-size:21px;font-weight:850}.footer p,.footer a{font-size:12px;line-height:1.55;color:#e2f2f4;text-decoration:none;margin:4px 0}.footer a{display:block}.footer h4{margin:0 0 8px;font-size:13px}.copyright{border-top:1px solid rgba(255,255,255,.22);padding:13px var(--pad) 18px;text-align:center;color:#ddf0f2;font-size:11px}.toast{position:fixed;right:20px;bottom:20px;background:#123c50;color:#fff;border-radius:10px;padding:13px 16px;box-shadow:0 12px 30px rgba(0,0,0,.22);display:none;z-index:200;font-size:13px}.toast.show{display:block} @media(max-width:1180px){ .desktop-nav{gap:11px}.desktop-nav a{font-size:13px}.hero-photo{width:57%}.hero-copy{width:55vw}.hero h1{font-size:62px}.finder{width:min(940px,82vw)} .cards{grid-template-columns:repeat(2,1fr)}.benefits{grid-template-columns:repeat(3,1fr)}.benefit{border-right:0!important}.cities-row{grid-template-columns:repeat(3,1fr)}.footer-grid{grid-template-columns:repeat(3,1fr)} } @media(max-width:900px){ .site-header{height:76px}.brand{font-size:23px}.brand-mark{width:49px;height:49px;flex-basis:49px}.desktop-nav{display:none}.menu-button{display:flex} .mobile-panel{display:none;position:fixed;z-index:110;top:76px;left:12px;right:12px;max-height:calc(100vh - 90px);overflow:auto;background:#fff;border:1px solid var(--line);border-radius:15px;padding:9px;box-shadow:var(--shadow)}.mobile-panel.open{display:block} .mobile-panel a,.mobile-panel summary{display:flex;align-items:center;justify-content:space-between;width:100%;padding:13px 14px;border-radius:9px;text-decoration:none;font-size:15px;font-weight:800;color:var(--navy);cursor:pointer;list-style:none}.mobile-panel summary::-webkit-details-marker{display:none}.mobile-panel details[open]>summary{background:#edf9fa;color:var(--teal-dark)}.mobile-sub{display:grid;gap:4px;padding:2px 6px 8px}.mobile-sub a{background:#f7fbfc;color:#3e5e6e;font-size:13px;padding-left:20px} .hero{min-height:auto;display:flex;flex-direction:column;background:#fff}.hero::after{display:none}.hero-content{order:1;padding-top:36px;padding-bottom:30px}.hero-copy{width:100%}.hero h1{font-size:clamp(44px,8.5vw,58px);line-height:1.01}.hero h1 .line:first-child{white-space:normal}.hero-copy>p{font-size:17px;max-width:690px}.finder{width:100%;margin-top:27px}.finder-grid{grid-template-columns:1fr 1fr}.search-btn{grid-column:1/-1;justify-content:center}.finder-points{grid-template-columns:1fr}.hero-photo{order:2;position:relative;width:100%;height:auto;aspect-ratio:16/10}.hero-photo img{object-fit:cover;object-position:center center} .directory-note .container{padding-top:15px;padding-bottom:15px}.steps{grid-template-columns:1fr}.step{border-right:0!important;border-bottom:1px dashed #9cc5cc;padding:21px 0}.step:last-child{border-bottom:0}.footer-grid{grid-template-columns:1fr 1fr} } @media(max-width:620px){ :root{--pad:18px}.site-header{height:70px}.brand{font-size:20px;gap:9px}.brand-mark{width:43px;height:43px;flex-basis:43px}.menu-button{width:43px;height:41px}.mobile-panel{top:70px} .hero-content{padding-top:28px}.hero h1{font-size:43px}.hero-copy>p{font-size:16px;line-height:1.55}.finder{padding:18px 16px;border-radius:14px}.finder-grid{grid-template-columns:1fr}.search-btn{grid-column:auto}.control,.search-btn{height:54px}.hero-photo{aspect-ratio:4/3}.hero-photo img{object-position:49% center} .directory-note .container{align-items:flex-start;justify-content:flex-start}.directory-note p{font-size:13px}.section{padding:42px 0}.section h2,.providers-section h2,.benefits-section h2{font-size:29px}.step{grid-template-columns:72px 1fr;gap:15px}.step-icon{width:68px;height:68px;border-radius:18px}.step-icon .icon{width:39px;height:39px}.step-title{font-size:16px}.cards{grid-template-columns:1fr}.vehicle-frame{height:auto;aspect-ratio:16/10;padding:8px}.vehicle-photo{width:100%;height:100%;object-fit:contain}.providers-head{align-items:flex-start}.providers-head h2{max-width:75%}.view-all{font-size:13px;margin-top:6px}.benefits{grid-template-columns:1fr}.benefit{padding:17px 4px}.cities-row{grid-template-columns:1fr 1fr;gap:10px}.footer-grid{grid-template-columns:1fr}.copyright{line-height:1.5} } </style></head><body><svg class="sr-only" aria-hidden="true" focusable="false" width="0" height="0"><symbol id="i-pin" viewBox="0 0 24 24"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></symbol><symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></symbol><symbol id="i-wheelchair" viewBox="0 0 24 24"><circle cx="9" cy="4" r="2"/><path d="M9 7v7h6l3 5M9 10h5M9 14a6 6 0 1 0 6 6"/></symbol><symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/><path d="M8 14h3M8 17h6"/></symbol><symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol><symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/><path d="m15 15 2 2 4-4"/></symbol><symbol id="i-dollar" viewBox="0 0 24 24"><path d="M12 2v20M17 6.5c-1-1-2.7-1.5-5-1.5-2.8 0-5 1.5-5 4s2.2 3.4 5 4 5 1.6 5 4-2.2 4-5 4c-2.3 0-4.1-.6-5-1.7"/></symbol><symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3 4.5 6v5.7c0 4.8 3.2 8.4 7.5 9.8 4.3-1.4 7.5-5 7.5-9.8V6L12 3Z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></symbol><symbol id="i-list" viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="m8 8 1.5 1.5L12 7M14 9h3M8 14l1.5 1.5L12 13M14 15h3"/></symbol><symbol id="i-phone" viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7A2 2 0 0 1 22 16.9Z"/></symbol><symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol><symbol id="i-people" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 20a6 6 0 0 1 12 0M14 20a5 5 0 0 1 7-4.6"/></symbol></svg><header class="site-header"><div class="container nav"><a class="brand" href="#home" aria-label="Ride2Dialysis home"><svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="27" fill="none" stroke="#087f8e" stroke-width="4"/><path d="M31 8v14M24 15h14" stroke="#087f8e" stroke-width="4" stroke-linecap="round"/><path d="M15 50c8-16 17-22 34-29-5 9-10 17-12 31" fill="#087f8e"/><path d="M26 49c3-10 8-17 16-22" stroke="#fff" stroke-width="3" stroke-linecap="round"/></svg><span>Ride2Dialysis.com</span></a><nav class="desktop-nav" aria-label="Primary navigation"><a class="active" href="#home">Home</a><a href="#finder">Find a Ride</a><a href="#providers">Providers</a><a href="#cities">Cities</a><a href="#how">How It Works</a><a href="#contact">Contact</a><a class="find-top" href="#finder"><svg class="icon"><use href="#i-pin"/></svg>Find Providers</a></nav><button class="menu-button" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobilePanel">☰</button></div></header><nav id="mobilePanel" class="mobile-panel" aria-label="Mobile navigation"><a href="#home">Home <span>→</span></a><details><summary>Find a Ride <span>⌄</span></summary><div class="mobile-sub"><a href="#finder">Search by ZIP Code</a><a href="#finder">Mobility Needs</a><a href="#finder">Service Type</a></div></details><details><summary>Providers <span>⌄</span></summary><div class="mobile-sub"><a href="#providers">Featured Providers</a><a href="#contact">Add Your Company</a></div></details><details><summary>Explore <span>⌄</span></summary><div class="mobile-sub"><a href="#cities">Cities</a><a href="#how">How It Works</a></div></details><a href="#contact">Contact <span>→</span></a></nav><main id="home"><section class="hero"><div class="hero-photo"><img src="hero-photo.webp?v=1" alt="Accessible dialysis transportation van assisting a wheelchair passenger outside a dialysis center"></div><div class="container hero-content"><div class="hero-copy"><h1><span class="line">Reliable Transportation</span><span class="line">to <em>Dialysis</em></span></h1><p>Find independent transportation providers who specialize in safe, comfortable, and on-time rides for dialysis patients.</p></div><form id="finder" class="finder"><div class="finder-grid"><div class="field"><label for="zip">ZIP Code</label><div class="control"><svg class="icon"><use href="#i-pin"/></svg><input id="zip" maxlength="5" inputmode="numeric" placeholder="Enter ZIP Code"></div></div><div class="field"><label for="mobility">Mobility Needs</label><div class="control"><svg class="icon"><use href="#i-wheelchair"/></svg><select id="mobility"><option value="">Select needs</optio